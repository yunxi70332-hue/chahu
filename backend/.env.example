# 环境变量模板:复制为 .env 后按部署环境填写(真实 .env 已被 .gitignore 排除,勿提交)
# 本地开发:cp backend/.env.example backend/.env

# SQLite 数据库文件绝对路径(Windows 示例 file:D:/baodan-data/baodan.db;Linux 示例 file:/www/baodan-data/baodan.db)
DATABASE_URL="file:/path/to/baodan-data/baodan.db"

# JWT 签名密钥:生产必须用 48 字节强随机值,更换后所有旧登录态失效
# 生成示例:node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-to-strong-random"

# 登录态有效期
JWT_EXPIRES="12h"

# 服务监听端口
PORT=3001

# 报价表脚本推送通道密钥(与 kdocs-export 端 baodan.json 保持一致)
IMPORT_KEY="change-me-to-shared-secret"

# 实名照片存储目录(可选,默认 ./uploads/idcards)
# PHOTO_DIR="/path/to/baodan-data/uploads/idcards"
